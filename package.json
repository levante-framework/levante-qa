{
  "name": "levante-qa",
  "version": "0.1.0",
  "private": true,
  "description": "QA / regression and VLM-agent benchmarking for LEVANTE core tasks using Cypress.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "cy:open": "cypress open",
    "cy:run": "cypress run",
    "cy:run:oracle": "cypress run --spec 'cypress/e2e/**/oracle.cy.ts'",
    "cy:run:wrong": "cypress run --spec 'cypress/e2e/**/wrong_agent.cy.ts'",
    "cy:run:vlm": "cypress run --spec 'cypress/e2e/**/vlm_agent.cy.ts'",
    "cy:run:audio": "cypress run --spec 'cypress/e2e/**/audio_assets.cy.ts'",
    "cy:run:egma:oracle": "cypress run --spec 'cypress/e2e/egma_math/oracle.cy.ts'",
    "cy:run:egma:vlm": "cypress run --spec 'cypress/e2e/egma_math/vlm_agent.cy.ts'",
    "cy:run:vocab:oracle": "cypress run --spec 'cypress/e2e/vocab/oracle.cy.ts'",
    "cy:run:vocab:vlm": "cypress run --spec 'cypress/e2e/vocab/vlm_agent.cy.ts'",
    "cy:run:stories:oracle": "cypress run --spec 'cypress/e2e/stories/oracle.cy.ts'",
    "cy:run:stories:vlm": "cypress run --spec 'cypress/e2e/stories/vlm_agent.cy.ts'",
    "cy:run:sds:oracle": "cypress run --spec 'cypress/e2e/same_different/oracle.cy.ts'",
    "cy:run:sds:vlm": "cypress run --spec 'cypress/e2e/same_different/vlm_agent.cy.ts'",
    "cy:run:mr:oracle": "cypress run --spec 'cypress/e2e/mental_rotation/oracle.cy.ts'",
    "cy:run:mr:vlm": "cypress run --spec 'cypress/e2e/mental_rotation/vlm_agent.cy.ts'",
    "cy:run:matrix:oracle": "cypress run --spec 'cypress/e2e/matrix_reasoning/oracle.cy.ts'",
    "cy:run:matrix:vlm": "cypress run --spec 'cypress/e2e/matrix_reasoning/vlm_agent.cy.ts'",
    "cy:run:trog:oracle": "cypress run --spec 'cypress/e2e/trog/oracle.cy.ts'",
    "cy:run:trog:vlm": "cypress run --spec 'cypress/e2e/trog/vlm_agent.cy.ts'",
    "cy:run:memory:oracle": "cypress run --spec 'cypress/e2e/memory_game/oracle.cy.ts'",
    "cy:run:pa:oracle": "LAUNCH=dashboard cypress run --spec 'cypress/e2e/pa/oracle.cy.ts'",
    "cy:run:sre:oracle": "LAUNCH=dashboard cypress run --spec 'cypress/e2e/sre/oracle.cy.ts'",
    "cy:run:sre:vlm": "LAUNCH=dashboard cypress run --spec 'cypress/e2e/sre/vlm_agent.cy.ts'",
    "cy:run:swr:oracle": "LAUNCH=dashboard cypress run --spec 'cypress/e2e/swr/oracle.cy.ts'",
    "cy:run:swr:vlm": "LAUNCH=dashboard cypress run --spec 'cypress/e2e/swr/vlm_agent.cy.ts'",
    "score": "tsx scripts/score.ts",
    "score:egma": "tsx scripts/score_egma.ts",
    "score:vocab": "tsx scripts/score_vocab.ts",
    "score:stories": "tsx scripts/score_stories.ts",
    "score:sds": "tsx scripts/score_sds.ts",
    "score:mr": "tsx scripts/score_mr.ts",
    "score:matrix": "tsx scripts/score_matrix.ts",
    "score:trog": "tsx scripts/score_trog.ts",
    "score:memory": "tsx scripts/score_memory.ts",
    "score:pa": "tsx scripts/score_pa.ts",
    "score:sre": "tsx scripts/score_sre.ts",
    "score:swr": "tsx scripts/score_swr.ts",
    "summarize": "tsx scripts/summarize_runs.ts",
    "persona:sync": "node scripts/sync_persona.mjs",
    "dashboard": "node dashboard/server.mjs",
    "sweep": "node scripts/daily-oracle-sweep.mjs",
    "run:assignment": "node scripts/run-assignment.mjs",
    "publish:assignments": "node scripts/publish-assignments.mjs",
    "lint": "eslint . --ext .ts",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^20.11.30",
    "@typescript-eslint/eslint-plugin": "^7.4.0",
    "@typescript-eslint/parser": "^7.4.0",
    "cypress": "^15.18.0",
    "eslint": "^8.57.0",
    "tsx": "^4.7.1",
    "typescript": "^5.4.3"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.20.1",
    "@google-cloud/storage": "^7.19.0",
    "@google/genai": "^2.6.0",
    "dotenv": "^16.4.5",
    "firebase-admin": "^13.5.0",
    "jszip": "^3.10.1",
    "n2words": "^5.0.0",
    "node-id3": "^0.2.9",
    "openai": "^4.33.0",
    "sharp": "^0.34.5",
    "zod": "^3.22.4"
  },
  "pnpm": {
    "overrides": {
      "qs@>=6.11.1 <=6.15.1": ">=6.15.2",
      "uuid@<11.1.1": ">=11.1.1",
      "esbuild@>=0.27.3 <0.28.1": ">=0.28.1",
      "protobufjs@<=7.6.2": ">=7.6.3",
      "form-data@>=4.0.0 <4.0.6": ">=4.0.6",
      "form-data@<2.5.6": ">=2.5.6",
      "js-yaml@<=4.1.1": ">=4.2.0"
    }
  }
}
