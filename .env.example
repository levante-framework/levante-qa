# Copy to .env and fill in the keys for the provider(s) you intend to run.
# Only the key for the active VLM_PROVIDER is required.

# Which VLM provider the askVLM cypress task dispatches to: openai | anthropic | gemini
VLM_PROVIDER=openai

# Optionally override the model per provider (sensible defaults are used otherwise).
# OPENAI_MODEL=gpt-4o
# ANTHROPIC_MODEL=claude-3-5-sonnet-latest
# GEMINI_MODEL=gemini-1.5-pro

# Provider API keys
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Override the task target. Defaults to the hosted demo when unset.
# BASE_URL=http://localhost:8080
