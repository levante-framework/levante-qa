# Copy to .env and fill in the keys for the provider(s) you intend to run.
# Only the key for the active VLM_PROVIDER is required.

# Which VLM provider the askVLM cypress task dispatches to: openai | anthropic | gemini
# A CLI flag `--env provider=<p>` overrides this for a single run.
VLM_PROVIDER=openai

# Optionally override the model per provider (current defaults shown).
# OPENAI_MODEL=gpt-4o
# ANTHROPIC_MODEL=claude-3-5-sonnet-latest
# GEMINI_MODEL=gemini-3.6-flash   # or gemini-3.5-flash-lite; 2.5 family EOL ~2026-10-16

# Provider API keys
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Override the task target. Defaults to the hosted demo when unset.
# BASE_URL=http://localhost:8080

# Prolific researcher API (https://app.prolific.com/account/api)
# PROLIFIC_API_TOKEN=
